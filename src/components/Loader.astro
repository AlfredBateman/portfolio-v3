---
// First visit only: the bearing counts from 000° up to 045° (northeast) while fonts load,
// then the ink sweeps off diagonally, southwest to northeast.
---
<div id="loader" role="status" aria-label="Loading">
  <div class="loader__inner">
    <p class="loader__label"><span data-loader-out>Finding northeast</span></p>
    <p class="loader__count"><span data-loader-out data-loader-count>000°</span></p>
  </div>
</div>
