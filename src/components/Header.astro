---
import Arrow from './Arrow.astro';
import Compass from './Compass.astro';
import { href, site } from '../data/site';
interface Props { current?: 'home' | 'work' | 'about'; lost?: boolean }
const { current, lost = false } = Astro.props;
const onHome = Astro.url.pathname === href();
// Every section, GitHub and the résumé are on every page, one tap away, phones included.
const links = [
  { label: 'Work', href: onHome ? '#work' : `${href()}#work`, current: current === 'work' ? ('true' as const) : undefined, dest: true },
  { label: 'About', href: href('about/'), current: current === 'about' ? ('page' as const) : undefined, dest: true },
  { label: 'GitHub', href: site.github, external: true },
  { label: 'Résumé', href: href(site.resume), download: true },
  { label: 'Contact', href: '#contact', dest: true },
];
---
<header class="header">
  <a class="brand" href={href()} data-dest={site.short} aria-label={`${site.name}, home`}>
    <Compass name="header" mini reach={2.5} />
    <span class="brand__name">{site.short}<span class="brand__last"> {site.name.split(' ').slice(1).join(' ')}</span></span>
  </a>
  <p class="readout" aria-hidden="true">
    <span data-bearing="header">{lost ? '---.-°' : '045.0°'}</span>
    <span class="readout__label" data-bearing-label="header">{lost ? 'lost' : 'NE'}</span>
  </p>
  <nav class="nav" aria-label="Main">
    <ul>
      {links.map((l) => (
        <li>
          <a
            class="nav__link"
            href={l.href}
            aria-current={l.current}
            data-dest={l.dest ? l.label : undefined}
            data-attract={l.label}
            download={l.download}
            target={l.external ? '_blank' : undefined}
            rel={l.external ? 'me noopener' : undefined}
          >
            <span class="roll" data-label={l.label}><span>{l.label}</span></span>
            {l.external && <Arrow />}
            {l.download && <Arrow down />}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
