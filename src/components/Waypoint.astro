---
// A section's label with its own compass. The needle turns toward the section's [data-aim] text while it is
// on screen (without one it holds the section's bearing). The bearing beside it is fixed: a page's sections step
// 45° at a time toward 045°, so the last one lands on northeast, and the header needle takes the bearing of the
// section in view. Put data-waypoint on the section. Leave out `label` when the section has its own heading.
import Compass from './Compass.astro';
interface Props { id: string; label?: string; deg: number }
const { id, label, deg } = Astro.props;
---
<div class="waypoint">
  <div class="waypoint__dial">
    <Compass name={`wp-${id}`} mini />
    <span class="waypoint__deg" aria-hidden="true" data-deg={deg}>{String(deg).padStart(3, '0')}°</span>
  </div>
  {label && <h2 class="label" id={`${id}-title`}>{label}</h2>}
</div>
