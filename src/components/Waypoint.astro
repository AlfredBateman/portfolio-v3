---
// A section's label with its own compass. The needle turns toward the section's [data-aim] text while it is
// on screen. The bearing beside it is fixed: a page's sections step 45° at a time toward 045°, so the last one
// lands on northeast. Put data-waypoint on the section.
import Compass from './Compass.astro';
interface Props { id: string; label: string; deg: number }
const { id, label, deg } = Astro.props;
---
<div class="waypoint">
  <div class="waypoint__dial">
    <Compass name={`wp-${id}`} mini />
    <span class="waypoint__deg" aria-hidden="true">{String(deg).padStart(3, '0')}°</span>
  </div>
  <h2 class="label" id={`${id}-title`}>{label}</h2>
</div>
