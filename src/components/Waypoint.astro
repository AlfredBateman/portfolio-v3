---
// A stop on the page's turn to northeast: a small compass, its bearing as a small figure, and the section's label.
// The needle holds the section's bearing (or turns toward its [data-aim] text, where there is one). A page's sections
// step 45° at a time toward 045°, so the last one lands on northeast, and the header needle turns from one bearing to
// the next as the page scrolls. Put data-waypoint on the section (and data-stop to name it in the header readout).
// Leave out `label` when the section has its own heading.
import Compass from './Compass.astro';
interface Props { id: string; label?: string; deg: number }
const { id, label, deg } = Astro.props;
---
<div class="waypoint">
  <div class="waypoint__dial">
    <Compass name={`wp-${id}`} mini rest={deg} />
    <span class="waypoint__deg" aria-hidden="true" data-deg={deg}>{String(deg).padStart(3, '0')}°</span>
  </div>
  {label && <h2 class="label" id={`${id}-title`}>{label}</h2>}
</div>
