---
// One diagram per project, in the site's ink: how the system works, drawn from fixed inputs. They are labelled
// illustrations, not screenshots. src/motion/figures.ts runs each one while it is on screen.
interface Props { slug: string }
const { slug } = Astro.props;
const W = 600;
const H = 380;

// AgentProbe: six cases, ten runs each, before and after a change. true = the run passed.
const runs = (fails: number[]) => Array.from({ length: 10 }, (_, j) => !fails.includes(j));
const cases = [
  { base: runs([]), cand: runs([]), verdict: 'same' },
  { base: runs([3, 7]), cand: runs([1, 5, 8]), verdict: 'flaky' },
  { base: runs([]), cand: runs([6]), verdict: 'same' },
  { base: runs([4]), cand: runs([1, 2, 3, 4, 6, 7, 8]), verdict: 'regression' },
  { base: runs([]), cand: runs([]), verdict: 'same' },
  { base: runs([8]), cand: runs([2]), verdict: 'same' },
];

// StockPilot: three queries and the path each one takes through the pipeline.
const stages = ['typo fix', 'rule parser', 'name search', 'hosted LLM'];
const queries = [
  { q: 'it stocks with pe under 25 and roe above 15', path: [1], chips: ['sector: IT', 'P/E < 25', 'ROE > 15'], note: 'Rule parser, offline. No network call.' },
  { q: 'banks near ther 52 week low', path: [0, 1], chips: ['sector: Banks', 'near 52-week low'], note: 'Typo fixed, then the rule parser.' },
  { q: 'tata consultncy', path: [0, 2], chips: ['company: TCS'], note: 'Typo fixed, then company-name search.' },
];
const chipW = (t: string) => Math.round(t.length * 9.6 + 30);
const chipX = (chips: string[]) => chips.reduce<number[]>((xs, _, i) => [...xs, i ? xs[i - 1] + chipW(chips[i - 1]) + 12 : 0], []);

// InvestorLens: a transcript excerpt, the quote the model proposed, and the guards it has to pass.
const transcript = [
  'Q: How do you track interviews?',
  'P4: Honestly, a mess of documents.',
  'I never know which notes made it',
  'into the final report.',
  'Q: And when you need a quote?',
  'P4: I search for twenty minutes.',
];
const checks = ['Schema valid', 'Quote found verbatim', 'Approved by a person'];

// CanvasLint: forty recorded frames, calls per frame as bars, lint warnings marked.
const frames = Array.from({ length: 40 }, (_, i) => Math.round(38 + 28 * Math.sin(i * 0.7) + 18 * Math.sin(i * 2.3 + 1) + (i % 9 === 4 ? 40 : 0)));
const flagged = new Set([4, 13, 22, 31]);
const log = ['save()', 'translate(120, 80)', 'rotate(0.42)', 'fillRect(0, 0, 40, 40)', 'restore()'];

const captions: Record<string, string> = {
  agentprobe: 'Illustration: six cases, ten runs each, before and after a change. A flaky case fails now and then on both sides and is left alone. Only a real drop is flagged.',
  stockpilot: 'Illustration of the query pipeline: which stages answer each query, and the filters they produce.',
  investorlens: 'Illustration: a pain point the model proposed, and the guards it passes before anything is saved.',
  canvaslint: 'Illustration of the DevTools panel: calls per recorded frame, lint warnings in red, and the log of the frame under the scrubber.',
};
---
<figure class="pfig rise-block" data-live={slug}>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={captions[slug]} focusable="false">
    {slug === 'agentprobe' && (
      <g>
        <text class="pfig__text pfig__muted" x="200" y="24" text-anchor="middle">baseline</text>
        <text class="pfig__text pfig__muted" x="420" y="24" text-anchor="middle">candidate</text>
        {cases.map((c, i) => {
          const y = 70 + i * 52;
          const bad = c.verdict === 'regression';
          return (
            <g>
              <text class="pfig__text" x="0" y={y + 6}>case {i + 1}</text>
              {c.base.map((ok, j) => <circle class:list={['pfig__run', { 'is-fail': !ok }]} cx={110 + j * 20} cy={y} r="6" data-run={j} />)}
              {c.cand.map((ok, j) => <circle class:list={['pfig__run', { 'is-fail': !ok, 'is-bad': bad }]} cx={330 + j * 20} cy={y} r="6" data-run={j} />)}
              <text class:list={['pfig__text', bad ? 'pfig__strong pfig__alert' : 'pfig__muted']} x="534" y={y + 6} data-verdict>{c.verdict}</text>
            </g>
          );
        })}
      </g>
    )}
    {slug === 'stockpilot' && (
      <g>
        <rect class="pfig__box" x="1" y="8" width={W - 2} height="58" />
        {queries.map((q, k) => (
          <g class="pfig__q" data-q={k} visibility={k ? 'hidden' : undefined}>
            <text class="pfig__text pfig__query" x="22" y="45" data-text={q.q}>{q.q}</text>
            {stages.map((s, i) => (
              <g class:list={[{ 'is-hot': q.path.includes(i) }]}>
                <rect class="pfig__node" x={i * 154} y="120" width="138" height="44" />
                <text class="pfig__text pfig__strong pfig__stage" x={i * 154 + 69} y="148" text-anchor="middle">{s}</text>
              </g>
            ))}
            {chipX(q.chips).map((x, i) => (
              <g>
                <rect class="pfig__chip" x={x} y="232" width={chipW(q.chips[i])} height="40" />
                <text class="pfig__text" x={x + 15} y="258">{q.chips[i]}</text>
              </g>
            ))}
            <text class="pfig__text pfig__muted" x="0" y="320">{q.note}</text>
          </g>
        ))}
        {[0, 1, 2].map((i) => <line class="pfig__line" x1={i * 154 + 138} y1="142" x2={i * 154 + 154} y2="142" />)}
        <line class="pfig__line" x1="300" y1="66" x2="300" y2="120" />
        <text class="pfig__text pfig__muted" x="0" y="214">filters</text>
      </g>
    )}
    {slug === 'investorlens' && (
      <g>
        <text class="pfig__text pfig__muted" x="0" y="20">Transcript, participant 4</text>
        <rect class="pfig__mark" x="-6" y="115" width="272" height="72" />
        {transcript.map((l, i) => <text class="pfig__text" x="0" y={64 + i * 38}>{l}</text>)}
        <line class="pfig__line" x1="272" y1="146" x2="318" y2="146" />
        <rect class="pfig__box" x="318" y="40" width="282" height="300" />
        <text class="pfig__text pfig__muted" x="338" y="74">Candidate pain point</text>
        <text class="pfig__text pfig__strong" x="338" y="106">Notes vanish before</text>
        <text class="pfig__text pfig__strong" x="338" y="130">the report is written</text>
        <text class="pfig__text pfig__quote" x="338" y="166">“I never know which notes</text>
        <text class="pfig__text pfig__quote" x="338" y="188">made it into the final report.”</text>
        {checks.map((c, i) => (
          <g class:list={['pfig__check', { 'is-done': i < 2 }]} data-check={i}>
            <rect x="338" y={226 + i * 34} width="18" height="18" />
            <path d={`M342 ${236 + i * 34} l4 4 l8 -9`} />
            <text class="pfig__text" x="368" y={241 + i * 34}>{c}</text>
          </g>
        ))}
      </g>
    )}
    {slug === 'canvaslint' && (
      <g>
        <text class="pfig__text pfig__muted" x="0" y="20" data-frame>frame 19 of 40</text>
        {frames.map((n, i) => (
          <g>
            <rect class:list={['pfig__bar', { 'is-hot': flagged.has(i) }]} x={i * 15} y={210 - n * 1.5} width="10" height={n * 1.5} data-bar={i} />
            {flagged.has(i) && <polygon class="pfig__flag" points={`${i * 15 + 5},${200 - n * 1.5} ${i * 15 + 11},${190 - n * 1.5} ${i * 15 - 1},${190 - n * 1.5}`} />}
          </g>
        ))}
        <line class="pfig__line" x1="0" y1="211" x2={W} y2="211" />
        <g class="pfig__scrub" transform="translate(275 0)"><line x1="0" y1="34" x2="0" y2="222" /><rect x="-7" y="214" width="14" height="14" /></g>
        {log.map((l, i) => (
          <text class:list={['pfig__text pfig__code', { 'is-on': i === 3 }]} x="0" y={266 + i * 26} data-log={i}>{l}</text>
        ))}
      </g>
    )}
  </svg>
  <figcaption>{captions[slug]}</figcaption>
</figure>
