---
import { ClientRouter } from 'astro:transitions';
import { href, site } from '../data/site';
import archivoUrl from '../fonts/archivo-100_900-normal.woff2?url';
import Loader from '../components/Loader.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/engine.css';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  current?: 'home' | 'work' | 'about';
  lost?: boolean; // the 404: the compass has nothing to point at
  loader?: boolean; // the first-visit loader (home only)
}
const { title, description = site.description, image = 'og.png', current, lost = false, loader = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(href(image), Astro.site ?? site.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: site.url,
  email: `mailto:${site.email}`,
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Chitkara University' },
  knowsAbout: ['Python', 'FastAPI', 'TypeScript', 'React', 'Next.js', 'Node.js', 'PostgreSQL', 'Testing', 'CI/CD'],
  sameAs: [...site.socials.map((s) => s.href), site.elsewhere.href],
};
---
<!doctype html>
<html lang="en" transition:animate="none" class={lost ? 'is-lost' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {lost ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#EDEEEA" />
    <link rel="icon" href={href("favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={href("favicon-32.png")} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={href("apple-touch-icon.png")} />
    <link rel="sitemap" href={href("sitemap-index.xml")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <script is:inline>
      document.documentElement.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
      try { if (sessionStorage.getItem('loader-seen')) document.documentElement.classList.add('loader-seen'); } catch {}
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="curtain" transition:persist="curtain" aria-hidden="true">
      <div class="curtain__panel"><p class="curtain__label" data-curtain-label></p></div>
    </div>
    {loader && <Loader />}
    <Header current={current} lost={lost} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { start } from '../engine/astro';
      import { setupMotion } from '../motion/setup';
      start(setupMotion);
    </script>
  </body>
</html>
