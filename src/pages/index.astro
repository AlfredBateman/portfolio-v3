---
import Base from '../layouts/Base.astro';
import Compass from '../components/Compass.astro';
import Arrow from '../components/Arrow.astro';
import Waypoint from '../components/Waypoint.astro';
import ProjectFigure from '../components/ProjectFigure.astro';
import { href, projects, site, testsLabel } from '../data/site';
import { emWidth } from '../data/fit';
---
<Base current="home">
  {/* Everything in the hero is in the first paint. Only the dial performs (src/motion/compass.ts). */}
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__lead">
      <h1 class="hero__who" id="hero-title">{site.name} <span>{site.role}</span></h1>
      <p class="hero__intro">
        I build backends and full-stack apps, and I write the tests: {testsLabel} across AgentProbe and StockPilot.
        Final-year computer science at Chitkara University, open to internships now and full-time roles from 2027.
      </p>
      <div class="hero__actions">
        <a class="cta cta--primary flood" href={href(site.resume)} download data-attract="Résumé">Résumé (PDF) <Arrow down /></a>
        <a class="cta flood" href={site.github} rel="me noopener" target="_blank" data-attract="GitHub">GitHub <Arrow /></a>
        <a class="cta flood" href={`mailto:${site.email}`} data-attract="Email">Email <Arrow /></a>
      </div>
    </div>
    <div class="hero__compass">
      <Compass name="hero" reach={2.4} />
      <button class="utility hero__true" type="button" data-true-ne aria-pressed="false" hidden>Point to real NE ↗</button>
    </div>
    <p class="hero__name" aria-hidden="true" style={`--em:${emWidth(site.short)}`}><span>{site.short}</span></p>
    <nav class="hero__strip" aria-label="Projects">
      <ol>
        {projects.map((p) => (
          <li>
            <a class="strip flood" href={href(`work/${p.slug}/`)} data-attract={p.title} data-dest={p.title}>
              <span class="strip__name">{p.title} <Arrow /></span>
              <span class="strip__state">{p.live ? 'Live' : p.status.split(' · ')[0]}</span>
              <span class="strip__tag">{p.tagline}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </section>

  <section class="work" id="work" aria-labelledby="work-title" data-waypoint>
    <div class="work__head">
      <Waypoint id="work" deg={135} />
      <h2 id="work-title" data-split="chars">Work</h2>
      <p data-reveal="fade">
        Four projects, each with its repository. AgentProbe and StockPilot are live, and CanvasLint is still in
        development. Open any one to see how it works.
      </p>
    </div>
    <ol class="index">
      {projects.map((p) => (
        <li>
          <a class="row flood" href={href(`work/${p.slug}/`)} data-attract={p.title} data-dest={p.title} data-peek={p.slug}>
            <span class="row__title" style={`--em:${emWidth(p.title)}`}>{p.title}</span>
            <span class="row__summary">{p.summary}</span>
            <span class="row__kind">{p.kind}</span>
            <span class="row__year">{p.status}{p.tests > 0 && ` · ${p.tests.toLocaleString('en-US')} tests`}</span>
            <Arrow />
          </a>
        </li>
      ))}
    </ol>
    <div class="peek" aria-hidden="true">
      <div class="peek__card">
        {projects.map((p) => <div data-peek-for={p.slug} hidden><ProjectFigure slug={p.slug} /></div>)}
      </div>
    </div>
  </section>

  <section class="facts" aria-labelledby="facts-title" data-waypoint>
    <Waypoint id="facts" deg={90} />
    <h2 class="facts__title" id="facts-title">So far</h2>
    <dl class="facts__list">
      <div data-reveal data-delay="0">
        <dt>Projects. AgentProbe and StockPilot are live</dt>
        <dd>4</dd>
      </div>
      <div data-reveal data-delay="0.08">
        <dt>Automated tests, across AgentProbe and StockPilot</dt>
        <dd>{testsLabel}</dd>
      </div>
      <div data-reveal data-delay="0.16">
        <dt>Graduating. Open to internships now</dt>
        <dd>2027</dd>
      </div>
    </dl>
  </section>
</Base>
