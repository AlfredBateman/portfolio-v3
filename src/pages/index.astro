---
import Base from '../layouts/Base.astro';
import Compass from '../components/Compass.astro';
import Arrow from '../components/Arrow.astro';
import Waypoint from '../components/Waypoint.astro';
import ProjectFigure from '../components/ProjectFigure.astro';
import { href, projects, site, testsLabel } from '../data/site';
import { emWidth } from '../data/fit';
---
<Base current="home">
  {/* Everything in the hero is in the first paint. Only the dial performs (src/motion/compass.ts). */}
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__lead">
      <h1 class="hero__who" id="hero-title">{site.name} <span>{site.role}</span></h1>
      <p class="hero__intro">
        I build backends and full-stack apps, and I write the tests: {testsLabel} across AgentProbe and StockPilot.
        Final-year computer science at Chitkara University, open to internships now and full-time roles from 2027.
      </p>
      <div class="hero__actions">
        <a class="cta cta--primary flood" href={href(site.resume)} download data-attract="Résumé">Résumé (PDF) <Arrow down /></a>
        <a class="cta flood" href={site.github} rel="me noopener" target="_blank" data-attract="GitHub">GitHub <Arrow /></a>
        <a class="cta flood" href={`mailto:${site.email}`} data-attract="Email">Email <Arrow /></a>
      </div>
    </div>
    <div class="hero__compass">
      <Compass name="hero" reach={2.4} />
      <button class="utility hero__true" type="button" data-true-ne aria-pressed="false" hidden>Point to real NE ↗</button>
    </div>
    <p class="hero__name" aria-hidden="true" style={`--em:${emWidth(site.short)}`}><span>{site.short}</span></p>
    <nav class="hero__strip" aria-label="Projects">
      <ol>
        {projects.map((p) => (
          <li>
            <a class="strip flood" href={`#${p.slug}`} data-attract={p.title}>
              <span class="strip__name">{p.title} <Arrow down /></span>
              <span class="strip__state">{p.live ? 'Live' : p.status.split(' · ')[0]}</span>
              <span class="strip__tag">{p.tagline}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </section>

  {/* Each project is a stop on the turn to northeast: 225°, 180°, 135°, 090°, then Contact on 045°. All text is in
      place from the first paint; the figure of the block at mid-screen runs (src/motion/figures.ts). */}
  <section class="work" id="work" aria-labelledby="work-title">
    <div class="work__head">
      <h2 id="work-title">Work</h2>
      <p>
        Four projects, each with its repository. AgentProbe and StockPilot are live, InvestorLens is released, and
        CanvasLint is still in development.
      </p>
    </div>
    <ol class="blocks">
      {projects.map((p, i) => (
        <li>
          <article class="block" id={p.slug} aria-labelledby={`${p.slug}-name`} data-waypoint data-stop={p.title}>
            <div class="block__bar">
              <Waypoint id={p.slug} deg={225 - i * 45} />
              <p class="block__status">{p.status}</p>
            </div>
            <h3 class="block__title" id={`${p.slug}-name`}>
              <a class="flood" href={href(`work/${p.slug}/`)} data-attract={p.title} data-dest={p.title} style={`--em:${emWidth(p.title)}`}>
                <span>{p.title}</span> <Arrow />
              </a>
            </h3>
            <div class="block__text">
              <p class="block__summary">{p.summary}</p>
              <dl class="block__facts">
                <div><dt>My part</dt><dd>{p.role}</dd></div>
                <div><dt>Stack</dt><dd>{p.stack.join(', ')}</dd></div>
                {p.tests > 0 && (
                  <div>
                    <dt>Tests</dt>
                    <dd>
                      {p.tests.toLocaleString('en-US')}{p.ci ? ', run in ' : ', run locally'}
                      {p.ci && <a class="link" href={p.ci} rel="noopener" target="_blank">CI ↗</a>}
                    </dd>
                  </div>
                )}
                {p.now && <div><dt>Works today</dt><dd>{p.now}</dd></div>}
                {p.next && <div><dt>Next</dt><dd>{p.next}</dd></div>}
              </dl>
              <p class="block__links">
                <a class="cta flood" href={href(`work/${p.slug}/`)} data-attract={p.title} data-dest={p.title}>Case study <Arrow /></a>
                <a class="cta flood" href={p.repo} rel="noopener" target="_blank" data-attract="GitHub">GitHub <Arrow /></a>
                {p.live && <a class="cta flood" href={p.live} rel="noopener" target="_blank" data-attract="Live app">Live app <Arrow /></a>}
              </p>
            </div>
            <div class="block__figure"><ProjectFigure slug={p.slug} /></div>
          </article>
        </li>
      ))}
    </ol>
  </section>
</Base>
