---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Waypoint from '../components/Waypoint.astro';
import { about, href, projects, site } from '../data/site';
const linkedin = site.socials.find((s) => s.label === 'LinkedIn')!.href;
---
<Base
  title="About"
  description="About Ishan Sharma: final-year Computer Science Engineering student at Chitkara University, looking for a backend or full-stack role. Bio, toolbox by project, education and certifications."
  current="about"
>
  {/* The first screen answers who this is and how to reach him. Everything is in the first paint. */}
  <section class="about-hero" aria-labelledby="about-title">
    <h1 id="about-title">About</h1>
    <div class="about-hero__bio">
      {about.bio.map((p) => <p>{p}</p>)}
    </div>
    <div class="about-hero__actions">
      <a class="cta cta--primary flood" href={`mailto:${site.email}`} data-attract="Email">Email me <Arrow /></a>
      <a class="cta flood" href={href(site.resume)} download data-attract="Résumé">Résumé (PDF) <Arrow down /></a>
      <a class="cta flood" href={site.github} rel="me noopener" target="_blank" data-attract="GitHub">GitHub <Arrow /></a>
      <a class="cta flood" href={linkedin} rel="me noopener" target="_blank" data-attract="LinkedIn">LinkedIn <Arrow /></a>
    </div>
    <dl class="about-hero__facts">
      {about.facts.map((f) => <div><dt>{f.k}</dt><dd>{f.v}</dd></div>)}
      <div><dt>Email</dt><dd><a class="link" href={`mailto:${site.email}`}>{site.email}</a></dd></div>
    </dl>
  </section>

  {/* Four stops on the turn: 225°, 180°, 135°, 090°, then Contact on 045° in the footer. */}
  <div class="rows">
    <section class="arow" aria-labelledby="tools-title" data-waypoint>
      <Waypoint id="tools" label="Toolbox" deg={225} />
      <div class="arow__body" data-aim>
        <dl class="kit">
          {projects.map((p) => (
            <div>
              <dt><a class="link" href={href(`work/${p.slug}/`)} data-dest={p.title}>{p.title}</a></dt>
              <dd><ul class="tags">{p.stack.map((s) => <li class="tag">{s}</li>)}</ul></dd>
            </div>
          ))}
          <div>
            <dt>Also</dt>
            <dd><ul class="tags">{about.also.map((s) => <li class="tag">{s}</li>)}</ul></dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="arow" aria-labelledby="edu-title" data-waypoint>
      <Waypoint id="edu" label="Education" deg={180} />
      <div class="arow__body" data-aim>
        <p class="arow__lead">{about.education.school}</p>
        <p>{about.education.degree}. {about.education.place}. {about.education.when}.</p>
        <p class="arow__muted">Coursework: {about.education.core.join(', ').toLowerCase().replace(/^./, (c) => c.toUpperCase())}.</p>
      </div>
    </section>

    <section class="arow" aria-labelledby="certs-title" data-waypoint>
      <Waypoint id="certs" label="Certifications" deg={135} />
      <div class="arow__body" data-aim>
        <ul class="ruled ruled--2">
          {about.certifications.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </section>

    <section class="arow" aria-labelledby="colophon-title" data-waypoint>
      <Waypoint id="colophon" label="Colophon" deg={90} />
      <div class="arow__body" data-aim>
        <p>
          Set in Archivo, stretched wide for display and kept at normal width for reading, with Anek Devanagari
          for the name on the dial. Built with Astro, GSAP and Lenis, hosted on GitHub Pages. No trackers, no
          cookies. The compass needle is a damped spring, and it always finds its way back to 045°.
        </p>
      </div>
    </section>
  </div>
</Base>
